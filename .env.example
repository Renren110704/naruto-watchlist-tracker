# Copy to server/.env (or a .env in the project root) and fill in the values.
# Never commit the real .env file.

# MongoDB connection string (local install, Docker, or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/naruto_watchlist

# Long random string (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long a sign-in lasts (jsonwebtoken format: 7d, 12h, ...)
JWT_EXPIRES_IN=7d

PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Optional
# BCRYPT_ROUNDS=12
# COOKIE_SECURE=false   # defaults to true when NODE_ENV=production (requires HTTPS)

# Client (Vite) – only needed if the API is not at http://localhost:5000 during development
# VITE_API_PROXY_TARGET=http://localhost:5000
