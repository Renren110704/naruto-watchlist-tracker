{
  "name": "naruto-watchlist-server",
  "description": "Express + MongoDB API for the Naruto Watchlist Tracker",
  "main": "server.js",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "extract:catalog": "node scripts/extract-catalog.js",
    "validate:catalog": "node scripts/validate-catalog.js",
    "seed": "node scripts/seed.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\""
  },
  "type": "module",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "pdfjs-dist": "^6.4.299",
    "supertest": "^7.3.1"
  },
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=20.11"
  }
}
